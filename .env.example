# ── Enagram Environment Variables ──
# Copy to .env and fill in your values

# MongoDB Atlas connection string (replace with your own)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/enagram?retryWrites=true&w=majority

# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# JWT expiry (optional, defaults shown)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MailerSend (for email verification, password reset, notifications)
# Get your API key from https://app.mailersend.com/
MAILERSEND_API_KEY=
EMAIL_FROM=Enagram <noreply@test-p7kx4xwed37g9yjr.mlsender.net>

# Cloudinary (for image uploads — logos, cover photos)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload directory
UPLOAD_DIR=uploads/
