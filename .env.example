# ── Enagram Environment Variables ──
# Copy to .env and fill in your values

# MongoDB Atlas connection string (replace with your own)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/enagram?retryWrites=true&w=majority

# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# JWT expiry (optional, defaults shown)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP (optional — for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Enagram <noreply@enagram.com>

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload directory
UPLOAD_DIR=uploads/
